# 模型配置（可以通过 Web UI 动态添加，自动写入），这里提供占位符样例
MODELS_CONFIG=[
  {
    "name": "ds-v4-flash",
    "modelId": "deepseek-v4-flash",
    "url": "https://api.deepseek.com/anthropic",
    "key": "sk-your-api-key",
    "id": "1778254008649",
    "contextWindow": 1000000
  },
  {
    "name": "ds-v4-pro",
    "modelId": "deepseek-v4-pro[1m]",
    "url": "https://api.deepseek.com/anthropic",
    "key": "sk-your-api-key",
    "id": "1778254133170",
    "contextWindow": 1000000
  }
]
# Tavily Search API Key — 用于 web_search 与 web_fetch 工具 (https://tavily.com)
TAVILY_API_KEY=tvly-your-tavily-api-key-here

# RAG embedding API key — 用于 Knowledge Base 向量化。
# 前端 Knowledge 页面只填写环境变量名，例如 ZHIPU_API_KEY，不要填写真实密钥。
ZHIPU_API_KEY=your-zhipu-api-key-here

# Qdrant Cloud 才需要；本地 docker-compose Qdrant 留空即可。
QDRANT_API_KEY=

# 服务端启动端口（可选，默认 3001）
PORT=3001
