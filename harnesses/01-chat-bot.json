{
  "id": "chat-bot",
  "name": "01-chat-bot.json",
  "description": "基础对话 agent",
  "category": "basic",
  "model": {
    "name": "Doubao Seed 2.0 Code",
    "response_format": "text",
    "temperature": 1,
    "max_tokens": 4096,
    "top_p": 1
  },
  "tools": [
    {
      "name": "weather_report",
      "description": "获取指定城市的天气信息",
      "input_schema": {
        "type": "object",
        "properties": {
          "city": {
            "type": "string",
            "description": "城市名称（如：北京、上海、New York）"
          }
        },
        "required": [
          "city"
        ]
      }
    },
    {
      "name": "bash",
      "description": "Execute a shell command. Use this to run scripts, navigate the filesystem, or interact with the OS.",
      "input_schema": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "description": "The bash command to execute"
          }
        },
        "required": [
          "command"
        ]
      }
    }
  ],
  "systemPrompt": "你是一个智能助手。\n\n当用户询问天气时，请：\n1. 分析用户提到的城市\n2. 调用 weather_report 工具获取天气\n3. 将结果以自然语言回复用户\n\n",
  "skills": [
    "skill-creator"
  ],
  "features": {
    "enable_security": false,
    "context_compaction": {
      "enabled": false,
      "thinking_compaction": false,
      "output_offload": false,
      "soft_compact": false,
      "hard_compact": false
    },
    "task_manager": {
      "enabled": false,
      "mode": "todo"
    },
    "enable_skills": {
      "enabled": false,
      "enable_project_skills": false,
      "enable_global_skills": false
    },
    "enable_memory": {
      "enabled": false,
      "memory_extract": false,
      "memory_consolidate": false
    },
    "error_recovery": {
      "enabled": false,
      "max_tokens_escalation": false,
      "reactive_compaction": false,
      "http_retry": false,
      "fallback_model": false,
      "fallback_model_id": "",
      "diminishing_returns": false
    },
    "parallel_tool_execution": false
  }
}