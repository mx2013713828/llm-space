{
  "id": "chat-bot",
  "name": "Basic Chatbot",
  "description": "Understand the basic ReAct tool call loop with weather query tools.",
  "category": "basic",
  "model": {
    "name": "Doubao Seed 2.0 Code",
    "response_format": "text",
    "temperature": 1,
    "max_tokens": 4096,
    "top_p": 1
  },
  "tools": [
    {
      "name": "weather_report",
      "description": "Get weather information for a specified city",
      "input_schema": {
        "type": "object",
        "properties": {
          "city": {
            "type": "string",
            "description": "The city name (e.g., Beijing, Shanghai, New York)"
          }
        },
        "required": [
          "city"
        ]
      }
    },
    {
      "name": "bash",
      "description": "Execute a shell command. Use this to run scripts, navigate the filesystem, or interact with the OS.",
      "input_schema": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "description": "The bash command to execute"
          }
        },
        "required": [
          "command"
        ]
      }
    }
  ],
  "systemPrompt": "You are a helpful assistant.\n\nWhen the user asks about the weather, please:\n1. Analyze the city mentioned by the user.\n2. Call the weather_report tool to get the weather information.\n3. Reply to the user with the result in natural language.\n\n",
  "skills": [
    "skill-creator"
  ],
  "features": {
    "enable_security": false,
    "context_compaction": {
      "enabled": false,
      "thinking_compaction": false,
      "output_offload": false,
      "soft_compact": false,
      "hard_compact": false
    },
    "task_manager": {
      "enabled": false,
      "mode": "todo"
    },
    "enable_skills": {
      "enabled": false,
      "enable_project_skills": false,
      "enable_global_skills": false
    },
    "enable_memory": {
      "enabled": false,
      "memory_extract": false,
      "memory_consolidate": false
    },
    "error_recovery": {
      "enabled": false,
      "max_tokens_escalation": false,
      "reactive_compaction": false,
      "http_retry": false,
      "fallback_model": false,
      "fallback_model_id": "",
      "diminishing_returns": false
    },
    "parallel_tool_execution": false
  }
}