{
  "id": "chat-bot",
  "name": "01-chat-bot.json",
  "description": "基础对话 agent",
  "category": "basic",
  "model": {
    "name": "Doubao Seed 2.0 Code",
    "response_format": "text",
    "temperature": 1,
    "max_tokens": 4096,
    "top_p": 1
  },
  "tools": [
    {
      "name": "weather_report",
      "description": "获取指定城市的天气信息",
      "input_schema": {
        "type": "object",
        "properties": {
          "city": {
            "type": "string",
            "description": "城市名称（如：北京、上海、New York）"
          }
        },
        "required": [
          "city"
        ]
      }
    },
    {
      "name": "bash",
      "description": "Execute a shell command. Use this to run scripts, navigate the filesystem, or interact with the OS.",
      "input_schema": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "description": "The bash command to execute"
          }
        },
        "required": [
          "command"
        ]
      }
    }
  ],
  "systemPrompt": "你是一个智能助手。\n\n当用户询问天气时，请：\n1. 分析用户提到的城市\n2. 调用 weather_report 工具获取天气\n3. 将结果以自然语言回复用户\n\n当用户搜索互联网信息时，请：\n1. 分析用户提到的关键词。\n2. 调用web_search 工具获取信息。\n3. 将结果整理后回复给用户。\n",
  "skills": [
    "skill-creator"
  ],
  "features": {
    "enable_security": true,
    "context_compaction": {
      "enabled": false,
      "thinking_compaction": false,
      "output_offload": false,
      "soft_compact": false,
      "hard_compact": false
    },
    "todo_nag": true,
    "enable_skills": {
      "enabled": true,
      "enable_project_skills": true,
      "enable_global_skills": true
    },
    "enable_memory": {
      "enabled": false,
      "memory_extract": false,
      "memory_consolidate": false
    },
    "parallel_tool_execution": false
  }
}