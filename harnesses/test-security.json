{
  "id": "test-security",
  "name": "test-security.json",
  "description": "",
  "category": "basic",
  "model": {
    "name": "",
    "response_format": "text",
    "temperature": 1,
    "max_tokens": 4096,
    "top_p": 1
  },
  "tools": [
    {
      "name": "bash",
      "description": "Execute a shell command. Use this to run scripts, navigate the filesystem, or interact with the OS.",
      "input_schema": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "description": "The bash command to execute"
          }
        },
        "required": [
          "command"
        ]
      }
    },
    {
      "name": "write_file",
      "description": "Write or overwrite contents into a file on the local filesystem.",
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Absolute or relative path to the file"
          },
          "content": {
            "type": "string",
            "description": "The exact content to write to the file"
          }
        },
        "required": [
          "path",
          "content"
        ]
      }
    },
    {
      "name": "read_file",
      "description": "Read the contents of a file from the local filesystem.",
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Absolute or relative path to the file"
          }
        },
        "required": [
          "path"
        ]
      }
    }
  ],
  "systemPrompt": "你是一个友好的智能助手，请准确、简洁地回答用户的问题。",
  "skills": [],
  "features": {
    "enable_security": true,
    "context_compaction": {
      "enabled": false,
      "thinking_compaction": false,
      "output_offload": false,
      "soft_compact": false,
      "hard_compact": false
    },
    "task_manager": {
      "enabled": true,
      "mode": "todo"
    },
    "enable_skills": {
      "enabled": true,
      "enable_project_skills": true,
      "enable_global_skills": true
    },
    "enable_memory": {
      "enabled": false,
      "memory_extract": false,
      "memory_consolidate": false
    },
    "parallel_tool_execution": false
  }
}